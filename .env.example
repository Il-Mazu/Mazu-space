# Copy to .env.local for `vercel dev`, and set the same names in the Vercel project.

# Last.fm (history, top tracks, scrobble count). Key from https://www.last.fm/api/account/create
# Without these, /api/music/* answers 503 and the Live chapel runs on Lanyard alone.
LASTFM_API_KEY=
LASTFM_USER=

# Optional, build time only: lifts GitHub's anonymous rate limit for the Works chapel data.
GITHUB_TOKEN=
