# Copy to .env.local for `vercel dev`, and set the same names in the Vercel project.

# Last.fm (history, top tracks, scrobble count). Key from https://www.last.fm/api/account/create
# Without these, /api/music/* answers 503 and the Live chapel runs on Lanyard alone.
LASTFM_API_KEY=
LASTFM_USER=

# Optional, build time only: lifts GitHub's anonymous rate limit for the Works chapel data.
GITHUB_TOKEN=

# Guestbook storage: Upstash Redis from the Vercel Marketplace sets these two.
# (A plain Upstash database's UPSTASH_REDIS_REST_URL / _TOKEN also work.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Any long random string. Salts the IP hash used for the 1-post-per-10-minutes limit.
IP_HASH_SALT=
# Any long random string. Paste it into /admin to delete entries.
GUESTBOOK_ADMIN_TOKEN=
